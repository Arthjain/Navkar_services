# Supabase — get from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Session secret — any long random string (openssl rand -base64 32)
SESSION_SECRET=change_me_to_a_long_random_string

# Google Sheet whitelist — publish your sheet as CSV
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv

# Admin — this email/phone gets is_admin=true and bypasses the whitelist
ADMIN_PHONE=+91XXXXXXXXXX
ADMIN_EMAIL=your_admin_email@example.com
